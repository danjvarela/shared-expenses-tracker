# App environment: development | production (defaults to development)
APP_ENV=development

# Log level: debug | info | warn | error (defaults to info)
LOG_LEVEL=info

# Drizzle
DATABASE_URL=file:local.db

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ops: shared secret required by POST /gc/receipts and /gc/avatars. App fails to boot if unset.
GC_SECRET=

# Receipt scanning (disabled unless set to "ocr")
RECEIPT_SCANNER_BACKEND=
OCR_API_KEY=

# Structuring backend for scanned receipt text: ollama | google (defaults to ollama)
STRUCTURING_BACKEND=
OLLAMA_TEXT_MODEL=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=

# File storage (default backend: fs)
RECEIPT_STORAGE_BACKEND=
RECEIPT_STORAGE_FS_DIR=
AVATAR_STORAGE_BACKEND=
AVATAR_STORAGE_FS_DIR=

# Cloudflare Tunnel (optional, for exposing the server publicly)
CLOUDFLARE_TUNNEL_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=

# Build / server
BUILD_OUT_DIR=
BODY_SIZE_LIMIT=
PORT=
